{
  "name": "@interview-app/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:native:windows": "node scripts/build-windows-loopback.mjs",
    "dev": "npm run build:native:windows && tsx scripts/dev-electron.ts",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:native:windows && tsc -p tsconfig.json && tsc -p tsconfig.electron.json && vite build",
    "package:win": "npm run build && electron-builder --win dir --config electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --config electron-builder.config.cjs",
    "test:keywords": "tsx scripts/test-runtime-keywords.ts",
    "test:transcript-focus": "tsx scripts/test-transcript-focus.ts",
    "test:overlay-runtime": "tsx scripts/test-overlay-runtime-stress.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@interview-app/shared": "*",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1"
  }
}
