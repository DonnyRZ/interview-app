API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/interview_app
CV_STORAGE_DIR=storage/cvs

# Frontend renderer
VITE_API_BASE_URL=http://127.0.0.1:4000

# OpenAI preprocessing phase
# Used for CV PDF extraction, JD summary, application context, and post-interview summary.
OPENAI_API_KEY=isi_api_key_openai_kamu
OPENAI_TEXT_MODEL=gpt-5-mini

# OpenAI realtime development phase
# Used for live interview: audio input -> text answer overlay.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_FALLBACK_MODEL=gpt-realtime-1.5
