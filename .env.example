API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/orviko_dev
PROFILE_DOCUMENT_STORAGE_DIR=storage/profile-documents

# Web App target
VITE_WEB_APP_API_BASE_URL=http://127.0.0.1:4000

FRONTEND_BASE_URL=http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
SESSION_SECRET=isi_session_secret_minimal_16_karakter

# Google OAuth sandbox/review
GOOGLE_CLIENT_ID=isi_google_client_id
GOOGLE_CLIENT_SECRET=isi_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/auth/google/callback

# Lynk.id checkout/webhook
LYNK_PROFILE_URL=https://lynk.id/rizki-09
LYNK_MINI_URL=
LYNK_STARTER_URL=
LYNK_PRO_URL=
# Stable provider product identifiers shown in Lynk webhook payloads.
LYNK_MINI_PRODUCT_ID=
LYNK_STARTER_PRODUCT_ID=
LYNK_PRO_PRODUCT_ID=
# High-entropy secret delivered only in the x-orviko-lynk-webhook-secret header.
# Query-string secrets are intentionally unsupported.
LYNK_WEBHOOK_SECRET=
# Set true only after Lynk confirms it will deliver the configured secret header
# (or an official signature adapter replaces this verifier). Production refuses
# to start while this remains false.
LYNK_WEBHOOK_PROVIDER_AUTH_CONFIRMED=false
PAYMENT_INTENT_TTL_MINUTES=60

# OpenAI preprocessing phase
# Used for profile document extraction, meeting brief summary, and reusable meeting context.
OPENAI_API_KEY=isi_api_key_openai_kamu
OPENAI_TEXT_MODEL=gpt-5-mini

# OpenAI realtime development phase
# Used for live meeting: audio input -> text help overlay.
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# Cost safety
OPENAI_KILL_SWITCH=false
# Keep pricing configurable because provider pricing can change independently from deploys.
OPENAI_TEXT_INPUT_USD_PER_1M=0
OPENAI_TEXT_OUTPUT_USD_PER_1M=0
OPENAI_REALTIME_TEXT_INPUT_USD_PER_1M=0
OPENAI_REALTIME_TEXT_OUTPUT_USD_PER_1M=0
OPENAI_REALTIME_AUDIO_INPUT_USD_PER_1M=0
OPENAI_REALTIME_AUDIO_OUTPUT_USD_PER_1M=0
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=180
AI_RATE_LIMIT_MAX_REQUESTS=20
PAYMENT_RATE_LIMIT_MAX_REQUESTS=30
MAX_CONCURRENT_LIVE_MEETINGS=1
MAX_LIVE_MEETING_MINUTES=90
REALTIME_CLIENT_SECRET_LIMIT_PER_SESSION=3

# Privacy/data lifecycle
PROFILE_DOCUMENT_RETENTION_DAYS=365
LIVE_TRANSCRIPT_RETENTION_DAYS=180
PAYMENT_EVENT_RETENTION_DAYS=2555
ACCOUNT_DELETION_JOB_RETENTION_DAYS=2555
OPERATIONS_TOKEN=replace-with-a-long-random-operations-token
AI_JOB_STUCK_MINUTES=20
